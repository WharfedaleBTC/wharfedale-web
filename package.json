{
  "name": "wharfedale-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wharfedale web app: explorer, network graph, demo wallet, faucet, asset creator",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.107.1",
    "@wharfedale/sdk": "file:../wharfedale-sdk-ts",
    "buffer": "6.0.3",
    "hono": "4.13.17",
    "idb": "8.0.3",
    "qrcode-generator": "2.0.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
